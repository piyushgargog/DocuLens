# Thin update image used for deploys to the EC2 instance.
#
# The instance's root disk is 6.7GB with ~1GB free, so rebuilding the full
# image (torch, sentence-transformers) next to the running one could fill it.
# Instead each release builds a small layer on top of the currently deployed
# image: same base and dependencies, the new application code, any requirement
# floors that changed, and security upgrades of the base tooling.
#
#   docker build -f deploy/Dockerfile.update -t doculens:vX.Y.Z .
#
# The full, from-scratch build remains ../Dockerfile.
FROM doculens:prod
WORKDIR /app
# OCR engine for scanned PDFs (see pdf_loader.py); English data only.
RUN apt-get update \
    && apt-get -y upgrade \
    && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/*
# The full image ships without pip (see ../Dockerfile); bring a current one back for this build.
RUN python -m ensurepip --upgrade && pip install --no-cache-dir --upgrade pip "setuptools>=83"
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
# Build tools out of the runtime image again (see ../Dockerfile for why).
RUN pip uninstall -y pip setuptools wheel
# Old font files from earlier releases live on in the base image; drop them.
RUN rm -f static/fonts/atkinson-hyperlegible-*.woff2 static/fonts/source-serif-4-variable.woff2

# Run as an unprivileged user, not root (defence in depth). The base image ran
# as root, so /app is chowned; the MiniLM model is fetched on first use, so its
# cache dir (HF_HOME) must be writable by that user.
ENV HF_HOME=/app/.cache/huggingface XDG_CACHE_HOME=/app/.cache
RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p /app/.cache/huggingface \
    && chown -R appuser:appuser /app
USER 10001

# Docker marks the container unhealthy if the app stops answering (no LLM call).
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=4)"]
