# Copy this file to .env and fill in your values.
#
# The app can use several AI providers and fails over between them when one
# is rate limited, out of quota, down or misconfigured (see providers.py).
# A provider is used only if its key is set -- one key is enough to run.
# Defaults: gpt-oss-120b (Groq, Hugging Face),
# Nemotron 3 Super 120B free (OpenRouter), gpt-oss-20b (NVIDIA).

# Order to try them in (default shown). Add "google" to use Gemini.
LLM_PROVIDERS=groq,openrouter,nvidia,huggingface

# 1. Groq -- https://console.groq.com/keys
#    (LLM_API_KEY is also accepted as the Groq key, for older .env files.)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional: a second Groq model, tried last. Each Groq model has its own
# daily quota, so this adds capacity.
LLM_FALLBACK_MODEL=openai/gpt-oss-20b

# 2. OpenRouter -- https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# 3. NVIDIA (build.nvidia.com) -- https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b

# 4. Hugging Face Inference Providers -- https://huggingface.co/settings/tokens
#    (a fine-grained token with "Make calls to Inference Providers")
HF_TOKEN=
HUGGINGFACE_MODEL=openai/gpt-oss-120b

# 5. Optional, opt-in: Google AI Studio (Gemini API) --
#    https://aistudio.google.com/apikey. Add "google" to LLM_PROVIDERS.
GEMINI_API_KEY=
GOOGLE_MODEL=gemini-3.6-flash

# Advanced: <NAME>_BASE_URL overrides a provider's endpoint, and
# LLM_BASE_URL / LLM_MODEL still configure the first (Groq) slot, e.g. to
# point it at any other OpenAI-compatible server.

# --- Observability (all optional) ---
# Log verbosity: DEBUG | INFO | WARNING | ERROR (default INFO).
LOG_LEVEL=INFO
# Error reporting via Sentry turns on ONLY if a DSN is set; nothing is sent
# otherwise. User document content is never attached (send_default_pii=False).
SENTRY_DSN=
SENTRY_TRACES_RATE=0
APP_ENV=production

# Trusted reverse-proxy networks (CIDR, comma-separated). Only these
# peers' X-Real-IP header is used for rate limiting. Default: loopback,
# right for Nginx on the same host talking to the app directly.
# In Docker with `-p 127.0.0.1:8000:8000` the app sees Nginx as the bridge
# gateway, so add it (check: `docker network inspect bridge`):
#   TRUSTED_PROXIES=172.17.0.1/32,127.0.0.0/8,::1/128
# Never use 0.0.0.0/0: any client could then spoof its address.
TRUSTED_PROXIES=127.0.0.0/8,::1/128

# --- Sign-in and shared state (all optional) ---
# Firebase Authentication with the Google provider (console.firebase.google.com
# > your project > Authentication > Sign-in method > Google; add your site's
# domain under Authentication > Settings > Authorized domains; the web config is
# under Project settings > General). These values are public, not secrets.
# Leave empty to run with no sign-in and no limits.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
# Optional; defaults to <project id>.firebaseapp.com
FIREBASE_AUTH_DOMAIN=
# Guests: 1 document, 5 questions/day, 3 uploads/day per IP. Signed in: 5
# documents and the USER_* caps below.
GUEST_MAX_DOCS=1
GUEST_DAILY_QUESTIONS=5
GUEST_DAILY_UPLOADS=3
USER_DAILY_QUESTIONS=200
USER_DAILY_UPLOADS=30
# Redis keeps logins and rate limits across restarts. Empty = in-process.
# Upstash (managed, TLS) works as-is: rediss://default:<password>@<name>.upstash.io:6379
REDIS_URL=

# --- Performance (all optional) ---
# Pre-load the embedding model at app startup instead of on the first
# upload (saves ~2s there, costs ~2s at start). Set to 1 for production.
PREFETCH_MODEL=0

# Optional resource/retrieval tuning. Lower MAX_TOTAL_CHUNKS (server-wide
# cap, ~3 KB per chunk) on small hosts.
MAX_TOTAL_CHUNKS=75000
# Opt-in similarity floor (0 = off, the default): a non-overview question whose
# best passage scores below it is refused without calling the model. It was on
# at 0.25 in v3.6.0 and wrongly refused real questions on short documents (a
# one-page resume scored 0.06-0.27), so measure with score_floor_eval.py on YOUR
# documents before enabling it.
RETRIEVAL_SCORE_FLOOR=0

# --- v4: more providers, models and tuning (all optional) ---
# Other providers: add the name to LLM_PROVIDERS and set its key.
#   anthropic ANTHROPIC_API_KEY | gemini GEMINI_API_KEY | cohere COHERE_API_KEY | openai OPENAI_API_KEY
#   mistral MISTRAL_API_KEY | deepseek DEEPSEEK_API_KEY | xai XAI_API_KEY | together TOGETHER_API_KEY
#   ollama (local server, no key; set OLLAMA_MODEL)
# Any model: <NAME>_MODEL takes a comma-separated list, e.g.
#   NVIDIA_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1,openai/gpt-oss-120b
# Any endpoint or family (openai|anthropic|gemini|cohere): LLM_ROUTES as JSON, e.g.
#   LLM_ROUTES=[{"name":"nemotron","api":"openai","base_url":"https://integrate.api.nvidia.com/v1","model":"nvidia/llama-3.1-nemotron-ultra-253b-v1","key_env":"NVIDIA_API_KEY"}]
LLM_ROUTES=
# Retrieval: structured (default) or char chunks; flat/hnsw/auto vector index.
CHUNKER=structured
VECTOR_INDEX=auto
ANN_THRESHOLD=20000
# Follow-up rewriting: off | auto (hard cases only) | always
REWRITE_LLM=auto
# Summary budget: model calls per summary, and characters per batch.
SUMMARY_MAX_LLM_CALLS=10
SUMMARY_BATCH_CHARS=6000
SUMMARY_CONCURRENCY=3
# OCR and extraction limits.
OCR_MAX_PAGES=30
OCR_TIME_BUDGET=60
OCR_LANG=eng
PDF_MAX_PAGES=2000
# Saved documents for signed-in users: retention, per-user allowance, optional directory for the blobs.
DOC_RETENTION_DAYS=30
USER_STORAGE_MB=20
ARTIFACT_DIR=
